# Freebuff client workspace metadata (not part of the app)
.freebuff/

# OS / editor junk
Thumbs.db
Desktop.ini
.DS_Store
*.log

# The older, separate copy of this app that lives inside this folder — it has its
# own .git and its own repository (dynamoadityam716-cpu/case-taking). Publishing
# it here would nest one repository inside another.
sih26047-software-newdb/

# ---- Live Match Tactics Agent -------------------------------------------
# Pre-fetched StatsBomb payloads are heavy (multi-MB) and re-downloadable —
# keep them local. The cleaned demo match is deliberately committed so the
# demo needs zero network. In the replay cache, only the pre-generated demo
# match (266033) is committed; anything else stays local.
match-tactics-agent/data/*.json
!match-tactics-agent/data/match.json
match-tactics-agent/data/raw/
match-tactics-agent/cache/*
!match-tactics-agent/cache/266033.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Never commit API keys
.env